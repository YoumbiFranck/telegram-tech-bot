TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_CHAT_ID=

TZ=Europe/Paris
LOG_LEVEL=INFO

# Horaires de publication (cron standard, min heure jour mois jour_semaine)
SCHEDULE_TECH_POST_CRON=0 8 * * *
SCHEDULE_NEWS_CRON=15 8 * * *
SCHEDULE_QUIZ_CRON=30 12 * * *

CLAUDE_BINARY_PATH=claude
CLAUDE_TIMEOUT_SECONDS=90

# UID/GID de build de l'image, alignés sur l'utilisateur hôte pour que les
# bind mounts de la session Claude Code restent accessibles (voir README).
APP_UID=1000
APP_GID=1000

# Répertoire home hôte contenant la session Claude Code authentifiée
# (~/.claude.json, ~/.claude/, ~/.local/*/claude). Ne concerne que
# compose.yml, pas lu par l'application elle-même.
CLAUDE_HOST_HOME=/home/franck

SCHEDULE_BACKUP_CRON=0 3 * * *

# Alerte email (Resend) sur echec definitif de generation - optionnel
RESEND_API_KEY=
ALERT_EMAIL_FROM=Telegram Tech Bot <onboarding@resend.dev>
ALERT_EMAIL_TO=

# Heartbeat Uptime Kuma (moniteur de type Push) - optionnel
UPTIME_KUMA_PUSH_URL=
HEARTBEAT_INTERVAL_SECONDS=300
